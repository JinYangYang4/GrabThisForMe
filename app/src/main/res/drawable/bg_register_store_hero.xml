<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:centerColor="#2B8C8F"
                android:endColor="#D78349"
                android:startColor="#164F62" />
        </shape>
    </item>

    <item
        android:width="260dp"
        android:height="260dp"
        android:gravity="top|end"
        android:right="-42dp"
        android:top="-58dp">
        <shape android:shape="oval">
            <gradient
                android:centerColor="#66FFF2D8"
                android:endColor="#00FFF2D8"
                android:gradientRadius="180dp"
                android:startColor="#AAFFF7E8"
                android:type="radial" />
        </shape>
    </item>

    <item
        android:width="210dp"
        android:height="210dp"
        android:bottom="-82dp"
        android:gravity="bottom|start"
        android:left="-54dp">
        <shape android:shape="oval">
            <gradient
                android:centerColor="#55FFFFFF"
                android:endColor="#00FFFFFF"
                android:gradientRadius="160dp"
                android:startColor="#99FFFFFF"
                android:type="radial" />
        </shape>
    </item>
</layer-list>
