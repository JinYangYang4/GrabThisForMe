<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:orientation="vertical">


        <LinearLayout
            android:id="@+id/ll_bottom_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_round_rect_top_small_bottom_no"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="10dp"
            android:paddingBottom="18dp">

            <View
                android:layout_width="42dp"
                android:layout_height="4dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_rounded_gray" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_cancel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingVertical="6dp"
                    android:text="取消"
                    android:textColor="@color/gray_800"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tv_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="分类管理"
                    android:textColor="@color/black"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_confirm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingVertical="6dp"
                    android:text="完成"
                    android:textColor="@color/orange_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_tab_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_rounded_white_day"
                android:backgroundTint="@color/gray_translucent_dark"
                android:orientation="horizontal"
                android:padding="4dp">

                <TextView
                    android:id="@+id/tv_tab_add"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_rounded_white"
                    android:gravity="center"
                    android:text="新增"
                    android:textColor="@color/orange_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_tab_rename"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="重命名"
                    android:textColor="@color/gray_800"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tv_tab_delete"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="删除"
                    android:textColor="@color/gray_800"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tv_tab_sort"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="排序"
                    android:textColor="@color/gray_800"
                    android:textSize="13sp" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/fl_content"
                android:layout_width="match_parent"
                android:layout_height="420dp"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:id="@+id/ll_add_category_content"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="输入新的分类名称"
                        android:textColor="@color/gray_700"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/et_new_category_name"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_chat_input"
                        android:hint="例如：饮料、主食、日用品"
                        android:imeOptions="actionDone"
                        android:inputType="text"
                        android:maxLength="12"
                        android:paddingHorizontal="14dp"
                        android:singleLine="true"
                        android:textColor="@color/black"
                        android:textColorHint="@color/gray_600"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="分类名不能为空，最多 12 个字"
                        android:textColor="@color/gray_600"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="end"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_add_category_cancel"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:gravity="center"
                            android:paddingHorizontal="18dp"
                            android:text="清空"
                            android:textColor="@color/gray_800"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tv_add_category_submit"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:layout_marginStart="10dp"
                            android:background="@drawable/bg_round_stripe_orange_small_corners"
                            android:gravity="center"
                            android:paddingHorizontal="20dp"
                            android:text="创建分类"
                            android:textColor="@color/white"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ll_rename_category_content"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="点击分类后可修改名称"
                        android:textColor="@color/gray_700"
                        android:textSize="13sp" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_rename_category"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_rounded_white_day"
                        android:paddingVertical="2dp" />

                    <LinearLayout
                        android:id="@+id/ll_rename_input_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_rounded_white_day"
                        android:orientation="vertical"
                        android:padding="10dp">

                        <TextView
                            android:id="@+id/tv_rename_target"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="当前分类："
                            android:textColor="@color/gray_700"
                            android:textSize="12sp" />

                        <EditText
                            android:id="@+id/et_rename_category_name"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/bg_chat_input"
                            android:hint="输入新的分类名"
                            android:imeOptions="actionDone"
                            android:inputType="text"
                            android:maxLength="12"
                            android:paddingHorizontal="14dp"
                            android:singleLine="true"
                            android:textColor="@color/black"
                            android:textColorHint="@color/gray_600"
                            android:textSize="14sp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:gravity="end"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tv_rename_cancel"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:gravity="center"
                                android:paddingHorizontal="16dp"
                                android:text="取消"
                                android:textColor="@color/gray_800"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/tv_rename_submit"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:layout_marginStart="10dp"
                                android:background="@drawable/bg_round_stripe_orange_small_corners"
                                android:gravity="center"
                                android:paddingHorizontal="20dp"
                                android:text="保存"
                                android:textColor="@color/white"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ll_delete_category_content"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="点击分类即可删除，商品自动转到“未分类”"
                        android:textColor="@color/gray_700"
                        android:textSize="13sp" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_delete_category"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_rounded_white_day"
                        android:paddingVertical="2dp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ll_sort_category_content"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="长按列表项后拖拽排序"
                        android:textColor="@color/gray_700"
                        android:textSize="13sp" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_sort_category"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_rounded_white_day"
                        android:paddingVertical="2dp" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</layout>
