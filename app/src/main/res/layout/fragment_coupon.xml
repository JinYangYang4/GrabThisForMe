<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <import type="android.view.View" />

        <variable
            name="viewModel"
            type="com.example.grabthisforme.activity.fragment_misc.couponFragment.viewModel.CouponViewModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_wallet_screen">

        <LinearLayout
            android:id="@+id/ll_describe_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_coupon_hero"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="38dp"
            android:paddingEnd="18dp"
            android:paddingBottom="24dp"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/iv_back"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_drawer_top_pill"
                    android:padding="8dp"
                    android:src="@drawable/ic_back" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="我的优惠券"
                        android:textColor="#FFFFFF"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="下单前自动帮你找到更划算的选择"
                        android:textColor="#FFE9D6"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="112dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_glass_panel_22"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="可用券包"
                        android:textColor="#7D3B22"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="3 张"
                        android:textColor="#351A10"
                        android:textSize="28sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="预计最高可省 ¥20"
                        android:textColor="#8B5940"
                        android:textSize="12sp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="82dp"
                    android:layout_height="82dp"
                    android:background="@drawable/bg_chip_warm"
                    android:padding="18dp"
                    android:src="@drawable/ic_coupon1" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/coupon_filter_card"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_marginStart="14dp"
            android:layout_marginTop="-10dp"
            android:layout_marginEnd="14dp"
            android:background="@drawable/bg_soft_card_26"
            android:elevation="7dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ll_describe_container">

            <TextView
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_marginHorizontal="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_primary_pill_orange"
                android:gravity="center"
                android:text="可使用"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_marginHorizontal="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_chip_warm"
                android:gravity="center"
                android:text="即将过期"
                android:textColor="#A85B1F"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_marginHorizontal="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_chip_mint"
                android:gravity="center"
                android:text="换券商城"
                android:textColor="#1D6F5E"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_coupon_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:clipToPadding="false"
            android:paddingHorizontal="12dp"
            android:paddingBottom="18dp"
            android:visibility="@{viewModel.emptyState ? View.GONE : View.VISIBLE}"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/coupon_filter_card" />

        <LinearLayout
            android:id="@+id/ll_empty_tip"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="28dp"
            android:background="@drawable/bg_soft_card_26"
            android:elevation="6dp"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="26dp"
            android:visibility="@{viewModel.emptyState ? View.VISIBLE : View.GONE}"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/coupon_filter_card">

            <ImageView
                android:layout_width="82dp"
                android:layout_height="82dp"
                android:background="@drawable/bg_chip_warm"
                android:padding="18dp"
                android:src="@drawable/ic_coupon" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="暂无可用优惠券"
                android:textColor="#172A2B"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="可以通过每日签到、活动任务或金币兑换获得更多优惠。"
                android:textColor="#6A7B7C"
                android:textSize="13sp" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
