<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <data>
        <import type="android.view.View" />
        <variable
            name="viewModel"
            type="com.example.grabthisforme.activity.fragment_misc.create.viewModel.CreateOrderViewModel" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/gray_mid_light"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/orange_primary"
            android:gravity="center_vertical"
            android:paddingTop="30dp"
            android:paddingBottom="10dp"
            android:paddingHorizontal="16dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iv_back"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_back" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="18dp"
                android:text="创建订单"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:orientation="horizontal"
            android:padding="16dp"
            android:layout_marginTop="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="业务类型："
                android:textSize="16sp"
                android:textColor="#333333"/>

            <RadioGroup
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rb_buy_goods"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="买商品"
                    android:textSize="15sp"
                    android:checked="@{viewModel.buyGoodsMode}"
                    android:textColor="@color/radio_text_selector"
                    app:buttonTint="@color/radio_button_tint"
                    android:layout_marginLeft="10dp"/>

                <RadioButton
                    android:id="@+id/rb_get_express"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="取快递"
                    android:textSize="15sp"
                    android:checked="@{!viewModel.buyGoodsMode}"
                    android:textColor="@color/radio_text_selector"
                    app:buttonTint="@color/radio_button_tint"
                    android:layout_marginLeft="20dp"/>
            </RadioGroup>
        </LinearLayout>
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_rounded_white"
                    android:gravity="center_vertical"
                    android:padding="16dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="选择收件地址信息"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#333333"/>
                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1"/>
                    <ImageView
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:src="@drawable/ic_position"/>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/ll_goods_info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_rounded_white"
                    android:padding="16dp"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical"
                    android:visibility="@{viewModel.buyGoodsMode ? View.VISIBLE : View.GONE}">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="商品信息"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#333333"/>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="8dp"
                        android:background="#E8E8E8"/>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="* 商品名称"
                        app:hintTextColor="#999999"
                        app:boxStrokeColor="#E8E8E8"
                        app:boxStrokeWidth="0dp"
                        app:hintEnabled="true">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_goods_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="15sp"
                            android:paddingVertical="8dp"
                            android:background="@null"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="* 目的地"
                        app:hintTextColor="#999999"
                        app:boxStrokeColor="#E8E8E8"
                        app:boxStrokeWidth="0dp"
                        app:hintEnabled="true">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_aim_position"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="15sp"
                            android:paddingVertical="8dp"
                            android:background="@null"/>
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="* 商品价格（元）"
                        app:hintTextColor="#999999"
                        app:boxStrokeColor="#E8E8E8"
                        app:boxStrokeWidth="0dp"
                        app:hintEnabled="true">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_goods_price"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="15sp"
                            android:paddingVertical="8dp"
                            android:inputType="numberDecimal"
                            android:background="@null"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="要求(可不填)"
                        app:hintTextColor="#999999"
                        app:boxStrokeColor="#E8E8E8"
                        app:boxStrokeWidth="0dp"
                        app:hintEnabled="true">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_goods_message"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="15sp"
                            android:paddingVertical="8dp"
                            android:background="@null"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="指定店铺(可不填)"
                        app:hintTextColor="#999999"
                        app:boxStrokeColor="#E8E8E8"
                        app:boxStrokeWidth="0dp"
                        app:hintEnabled="true">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_shelf_number"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="15sp"
                            android:paddingVertical="8dp"
                            android:background="@null"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="8dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="购买数量"
                            android:textSize="15sp"
                            android:textColor="@color/black"
                            android:layout_marginBottom="4dp"/>
                        <View
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_weight="1">

                        </View>
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:background="#F5F5F5"
                            android:gravity="center">
                            <ImageView
                                android:id="@+id/btn_minus"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_decrease"
                                android:padding="0dp"/>

                            <TextView
                                android:id="@+id/tv_sale_number"
                                android:layout_width="45dp"
                                android:layout_height="match_parent"
                                android:background="@null"
                                android:gravity="center"
                                android:paddingHorizontal="8dp"
                                android:text="1"
                                android:textColor="#333333"
                                android:textSize="15sp" />
                            <ImageView
                                android:id="@+id/btn_plus"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_increase"
                                android:padding="0dp"/>
                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="商品图片(可不填)"
                            android:textSize="15sp"
                            android:textColor="#999999"/>

                        <ImageView
                            android:id="@+id/iv_goods_pic"
                            android:layout_width="80dp"
                            android:layout_height="80dp"
                            android:layout_marginTop="8dp"
                            android:src="@drawable/ic_add"
                            android:scaleType="centerCrop"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="8dp">

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="开始时间"
                            app:hintTextColor="#999999"
                            app:boxStrokeColor="#E8E8E8"
                            app:boxStrokeWidth="0dp"
                            app:hintEnabled="true">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/et_start_time"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textSize="15sp"
                                android:paddingVertical="8dp"
                                android:focusable="false"
                                android:text="@{viewModel.startTime}"
                                android:background="@null"/>
                        </com.google.android.material.textfield.TextInputLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=" - "
                            android:textSize="15sp"
                            android:paddingHorizontal="8dp"
                            android:gravity="center"/>

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="结束时间"
                            app:hintTextColor="#999999"
                            app:boxStrokeColor="#E8E8E8"
                            app:boxStrokeWidth="0dp"
                            app:hintEnabled="true">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/et_end_time"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textSize="15sp"
                                android:paddingVertical="8dp"
                                android:focusable="false"
                                android:text="@{viewModel.endTime}"
                                android:background="@null"/>
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ll_express_info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_rounded_white"
                    android:padding="16dp"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical"
                    android:visibility="@{viewModel.buyGoodsMode ? View.GONE : View.VISIBLE}">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="快递信息"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#333333"/>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="8dp"
                        android:background="#E8E8E8"/>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="* 快递单号"
                        app:hintTextColor="#999999"
                        app:boxStrokeColor="#E8E8E8"
                        app:boxStrokeWidth="0dp"
                        app:hintEnabled="true">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_express_no"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="15sp"
                            android:paddingVertical="8dp"
                            android:background="@null"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="* 快递公司"
                        app:hintTextColor="#999999"
                        app:boxStrokeColor="#E8E8E8"
                        app:boxStrokeWidth="0dp"
                        app:hintEnabled="true">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_express_company"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="15sp"
                            android:paddingVertical="8dp"
                            android:background="@null"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="* 取件位置（驿站/快递柜编号）"
                        app:hintTextColor="#999999"
                        app:boxStrokeColor="#E8E8E8"
                        app:boxStrokeWidth="0dp"
                        app:hintEnabled="true">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_express_position"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="15sp"
                            android:paddingVertical="8dp"
                            android:background="@null"/>
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="* 取件码"
                        app:hintTextColor="#999999"
                        app:boxStrokeColor="#E8E8E8"
                        app:boxStrokeWidth="0dp"
                        app:hintEnabled="true">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_pickup_code"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="15sp"
                            android:paddingVertical="8dp"
                            android:background="@null"/>
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="备注(可不填)"
                        app:hintTextColor="#999999"
                        app:boxStrokeColor="#E8E8E8"
                        app:boxStrokeWidth="0dp"
                        app:hintEnabled="true">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_express_remark"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="15sp"
                            android:paddingVertical="8dp"
                            android:background="@null"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="8dp">

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="开始时间"
                            app:hintTextColor="#999999"
                            app:boxStrokeColor="#E8E8E8"
                            app:boxStrokeWidth="0dp"
                            app:hintEnabled="true">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/et_express_start_time"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textSize="15sp"
                                android:paddingVertical="8dp"
                                android:focusable="false"
                                android:text="@{viewModel.expressStartTime}"
                                android:background="@null"/>
                        </com.google.android.material.textfield.TextInputLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=" - "
                            android:textSize="15sp"
                            android:paddingHorizontal="8dp"
                            android:gravity="center"/>

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="结束时间"
                            app:hintTextColor="#999999"
                            app:boxStrokeColor="#E8E8E8"
                            app:boxStrokeWidth="0dp"
                            app:hintEnabled="true">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/et_express_end_time"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textSize="15sp"
                                android:paddingVertical="8dp"
                                android:focusable="false"
                                android:text="@{viewModel.expressEndTime}"
                                android:background="@null"/>
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>
                </LinearLayout>
                <Button
                    android:id="@+id/btn_create_order"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="16dp"
                    android:background="@drawable/bg_round_stripe_orange"
                    app:backgroundTint="@color/orange_light"
                    android:text="创建订单"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:enabled="false"/>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>



    </LinearLayout>
</layout>