<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <data>
        <variable
            name="viewModel"
            type="com.example.grabthisforme.activity.mainactivity.viewmodel.OrderMessageViewModel" />
    </data>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"

        android:orientation="vertical">
        <androidx.core.widget.NestedScrollView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                tools:ignore="MissingConstraints">

                <ImageView
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:id="@+id/iv_head_pic"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    android:layout_marginTop="20dp"
                    android:layout_marginStart="20dp"
                    android:src="@drawable/cat"
                    android:padding="2dp"
                    android:backgroundTint="@color/white_fff8"
                    android:background="@drawable/bg_circle"
                    android:scaleType="centerCrop"
                    android:clipToOutline="true" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginEnd="20dp"
                    android:orientation="horizontal"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/iv_head_pic"
                    app:layout_constraintTop_toTopOf="@id/iv_head_pic">

                    <TextView
                        android:id="@+id/buyer_signature"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="说说："
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/buyer_signature_context"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="日子慢慢过，美好慢慢遇，不慌不忙，在自己的节奏里感受生活的小美好，平安喜乐就好"
                        android:textSize="12sp"
                        android:maxLines="3"
                        android:ellipsize="end" />
                </LinearLayout>




                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:id="@+id/ll_buyer_name"
                    app:layout_constraintTop_toBottomOf="@+id/iv_head_pic"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/buyer"
                        android:layout_marginStart="20dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textStyle="bold"
                        android:text="买家："/>

                    <TextView
                        android:id="@+id/buyer_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@{viewModel.buyerName}"
                        app:layout_goneMarginStart="4dp" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:id="@+id/ll_buyer_need"
                    app:layout_constraintTop_toBottomOf="@+id/ll_buyer_name"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/need"
                        android:layout_marginStart="20dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textStyle="bold"
                        android:text="要求："/>
                    <TextView
                        android:id="@+id/need_context"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="请您提前准备好相关证件及材料，按预约时段前往指定地点办理业务。现场请配合工作人员指引，保持秩序。办理完成后核对信息无误再离开，如有疑问可咨询现场工作人员或致电服务热线。"
                        app:layout_goneMarginStart="4dp" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/ll_sender_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:layout_constraintTop_toBottomOf="@+id/ll_buyer_need"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/sender"
                        android:layout_marginStart="20dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textStyle="bold"
                        android:text="跑腿："/>

                    <TextView
                        android:id="@+id/sender_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="姓名"
                        app:layout_goneMarginStart="4dp" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/ll_goods_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:layout_constraintTop_toBottomOf="@+id/ll_sender_name"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/goods"
                        android:layout_marginStart="20dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textStyle="bold"
                        android:text="商品："/>

                    <TextView
                        android:id="@+id/goods_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="商品名"
                        app:layout_goneMarginStart="4dp" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/ll_goods_at_position"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:layout_constraintTop_toBottomOf="@+id/ll_goods_name"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/goods_at_position"
                        android:layout_marginStart="20dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textStyle="bold"
                        android:text="位置："/>

                    <TextView
                        android:id="@+id/goods_at_position_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="位置名"
                        app:layout_goneMarginStart="4dp" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/ll_goods_aim_position"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:layout_constraintTop_toBottomOf="@+id/ll_goods_at_position"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/goods_aim_position"
                        android:layout_marginStart="20dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textStyle="bold"
                        android:text="目的地："/>

                    <TextView
                        android:id="@+id/goods_aim_position_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="位置名"
                        app:layout_goneMarginStart="4dp" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/ll_order_time"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:layout_constraintTop_toBottomOf="@+id/ll_goods_aim_position"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/tv_order_time"
                        android:layout_marginStart="20dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textStyle="bold"
                        android:text="还剩时间："/>
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/ll_order_start_time_message"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="开始时间"
                            app:layout_goneMarginStart="4dp" />
                        <TextView
                            android:id="@+id/ll_order_end_time_message"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="结束时间"
                            app:layout_goneMarginStart="4dp" />
                    </LinearLayout>


                </LinearLayout>
                <LinearLayout
                    android:id="@+id/ll_order_left_time"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:layout_constraintTop_toBottomOf="@+id/ll_order_time"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/tv_order_left_time"
                        android:layout_marginStart="20dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textStyle="bold"
                        android:text="还剩时间："/>

                    <TextView
                        android:id="@+id/ll_order_left_time_message"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="时间"
                        app:layout_goneMarginStart="4dp" />
                </LinearLayout>
                <ImageView
                    android:layout_marginTop="10dp"
                    app:layout_constraintTop_toBottomOf="@+id/ll_order_left_time"
                    android:layout_width="match_parent"
                    android:maxHeight="300dp"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_back_charactor2"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"/>

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>


</layout>
