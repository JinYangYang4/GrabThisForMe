<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="10dp">
        <TextView
            android:id="@+id/tv_share"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginStart="10dp"
            android:layout_marginTop="10dp"
            android:text="分享给"
            android:textSize="13sp" />
        <androidx.recyclerview.widget.RecyclerView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/rv_share_to_user"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_share"
            android:layout_marginTop="10dp"/>
        <View
            android:id="@+id/v1"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/green_dark"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/rv_share_to_user"
            android:layout_margin="20dp"/>
        <EditText
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/v1"
            android:layout_marginTop="10dp"
            android:id="@+id/et_share_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="说说此刻感想..."
            android:maxLines="7"
            android:minHeight="30dp"
            android:padding="12dp"
            android:background="@drawable/bg_round_stripe"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/et_share_input"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">
            <LinearLayout
                android:id="@+id/ll_cancel"
                android:layout_width="0dp"
                android:elevation="10dp"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_rounded_white"
                android:gravity="center">
                <TextView
                    android:id="@+id/tv_cancel"
                    android:layout_width="wrap_content"
                    android:paddingVertical="10dp"
                    android:textSize="16sp"
                    android:layout_height="wrap_content"
                    android:text="取消"/>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/ll_sure"
                android:layout_width="0dp"
                android:elevation="10dp"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                android:textSize="16sp"
                android:layout_weight="1"
                android:background="@drawable/bg_rounded_white"
                android:gravity="center">
                <TextView
                    android:id="@+id/tv_sure"
                    android:layout_width="wrap_content"
                    android:paddingVertical="10dp"
                    android:layout_height="wrap_content"
                    android:text="分享"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
