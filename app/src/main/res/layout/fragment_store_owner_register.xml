<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="viewModel"
            type="com.example.grabthisforme.activity.fragment_misc.my_store.viewmodel.RegisterStoreViewModel" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/gray_mid_light"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/ll_top_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_arc_gradient_blue"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="30dp"
            android:paddingEnd="16dp"
            android:paddingBottom="10dp">

            <ImageView
                android:id="@+id/iv_back"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_back" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:text="注册商家"
                android:textColor="@color/white"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>

        <androidx.core.widget.NestedScrollView
            android:id="@+id/nested_scroll_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/white">

            <LinearLayout
                android:id="@+id/ll_form_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginEnd="16dp"
                    android:background="@drawable/bg_round_stripe"
                    android:backgroundTint="@color/white"
                    android:elevation="2dp"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@{`店长：` + viewModel.currentUser.name}"
                        android:textColor="#333333"
                        android:textSize="16sp"
                        android:textStyle="bold" />


                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:hint="店主ID"
                        app:boxStrokeWidth="0dp"
                        app:hintEnabled="true"
                        app:hintTextColor="#999999">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_owner_id"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@null"
                            android:enabled="false"
                            android:focusable="false"
                            android:paddingVertical="8dp"
                            android:text="@{viewModel.ownerIdText}"
                            android:textColor="@color/blue_light"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            tools:text="10001" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginEnd="16dp"
                    android:background="@drawable/bg_round_stripe"
                    android:backgroundTint="@color/white"
                    android:elevation="2dp"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="店铺信息"
                        android:textColor="#333333"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="8dp"
                        android:background="#E8E8E8" />

                    <!-- 店铺名称 -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="* 店铺名称"
                        app:boxBackgroundMode="outline"
                        app:boxStrokeColor="@color/blue_light"
                        app:boxStrokeWidth="0dp"
                        app:boxStrokeWidthFocused="1dp"
                        app:hintEnabled="true"
                        app:hintTextColor="@color/blue_light">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_store_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@null"
                            android:paddingVertical="8dp"
                            android:textColor="@color/blue_light"
                            android:textSize="15sp"
                            android:cursorVisible="true"
                            android:textCursorDrawable="@color/blue_light"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- 店铺类型 -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="* 店铺类型"
                        app:boxBackgroundMode="outline"
                        app:boxStrokeColor="@color/blue_light"
                        app:boxStrokeWidth="0dp"
                        app:boxStrokeWidthFocused="1dp"
                        app:hintEnabled="true"
                        app:hintTextColor="@color/blue_light">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_store_type"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@null"
                            android:paddingVertical="8dp"
                            android:textColor="@color/blue_light"
                            android:textSize="15sp"
                            android:cursorVisible="true"
                            android:textCursorDrawable="@color/blue_light"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- 店铺地址 -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="* 店铺地址"
                        app:boxBackgroundMode="outline"
                        app:boxStrokeColor="@color/blue_light"
                        app:boxStrokeWidth="0dp"
                        app:boxStrokeWidthFocused="1dp"
                        app:hintEnabled="true"
                        app:hintTextColor="@color/blue_light">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_store_address"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@null"
                            android:paddingVertical="8dp"
                            android:textColor="@color/blue_light"
                            android:textSize="15sp"
                            android:cursorVisible="true"
                            android:textCursorDrawable="@color/blue_light"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- 联系电话 -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="* 联系电话"
                        app:boxBackgroundMode="outline"
                        app:boxStrokeColor="@color/blue_light"
                        app:boxStrokeWidth="0dp"
                        app:boxStrokeWidthFocused="1dp"
                        app:hintEnabled="true"
                        app:hintTextColor="@color/blue_light">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_phone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@null"
                            android:inputType="phone"
                            android:paddingVertical="8dp"
                            android:textColor="@color/blue_light"
                            android:textSize="15sp"
                            android:cursorVisible="true"
                            android:textCursorDrawable="@color/blue_light"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="营业时间:"
                        android:textSize="13sp"
                        android:layout_marginTop="8dp"/>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="开始时间"
                            app:boxBackgroundMode="outline"
                            app:boxStrokeColor="@color/blue_light"
                            app:boxStrokeWidth="0dp"
                            app:boxStrokeWidthFocused="1dp"
                            app:hintEnabled="true"
                            app:hintTextColor="@color/blue_light">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/et_start_time"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textSize="15sp"
                                android:paddingVertical="8dp"
                                android:focusable="false"
                                android:text="@{viewModel.startTime}"
                                android:textColor="@color/blue_light"
                                android:background="@null"
                                android:textCursorDrawable="@color/blue_light"/>
                        </com.google.android.material.textfield.TextInputLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=" - "
                            android:textSize="15sp"
                            android:paddingHorizontal="8dp"
                            android:gravity="center"/>

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="结束时间"
                            app:boxBackgroundMode="outline"
                            app:boxStrokeColor="@color/blue_light"
                            app:boxStrokeWidth="0dp"
                            app:boxStrokeWidthFocused="1dp"
                            app:hintEnabled="true"
                            app:hintTextColor="@color/blue_light">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/et_end_time"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textSize="15sp"
                                android:paddingVertical="8dp"
                                android:focusable="false"
                                android:text="@{viewModel.endTime}"
                                android:textColor="@color/blue_light"
                                android:background="@null"
                                android:textCursorDrawable="@color/blue_light"/>
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="起送金额"
                            app:boxBackgroundMode="outline"
                            app:boxStrokeColor="@color/blue_light"
                            app:boxStrokeWidth="0dp"
                            app:boxStrokeWidthFocused="1dp"
                            app:hintEnabled="true"
                            app:hintTextColor="@color/blue_light">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/et_min_order_amount"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@null"
                                android:inputType="numberDecimal"
                                android:paddingVertical="8dp"
                                android:textColor="@color/blue_light"
                                android:textSize="15sp"
                                android:cursorVisible="true"
                                android:textCursorDrawable="@color/blue_light"/>
                        </com.google.android.material.textfield.TextInputLayout>

                        <View
                            android:layout_width="10dp"
                            android:layout_height="1dp" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="配送费"
                            app:boxBackgroundMode="outline"
                            app:boxStrokeColor="@color/blue_light"
                            app:boxStrokeWidth="0dp"
                            app:boxStrokeWidthFocused="1dp"
                            app:hintEnabled="true"
                            app:hintTextColor="@color/blue_light">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/et_delivery_fee"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@null"
                                android:inputType="numberDecimal"
                                android:paddingVertical="8dp"
                                android:textColor="@color/blue_light"
                                android:textSize="15sp"
                                android:cursorVisible="true"
                                android:textCursorDrawable="@color/blue_light"/>
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="选择头像(可不填)"
                            android:textSize="15sp"
                            android:textColor="#999999"/>

                        <ImageView
                            android:id="@+id/iv_head_pic"
                            android:layout_width="70dp"
                            android:layout_height="70dp"
                            android:layout_marginTop="8dp"
                            android:src="@drawable/ic_add"
                            android:scaleType="centerCrop"/>
                    </LinearLayout>

                    <!-- 店铺标签 -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="店铺标签（可选，逗号分隔）"
                        app:boxBackgroundMode="outline"
                        app:boxStrokeColor="@color/blue_light"
                        app:boxStrokeWidth="0dp"
                        app:boxStrokeWidthFocused="1dp"
                        app:hintEnabled="true"
                        app:hintTextColor="@color/blue_light">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_store_tags"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@null"
                            android:paddingVertical="8dp"
                            android:textColor="@color/blue_light"
                            android:textSize="15sp"
                            android:cursorVisible="true"
                            android:textCursorDrawable="@color/blue_light"
                            tools:text="零食, 快送, 附近" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="营业状态"
                            android:textColor="#333333"
                            android:textSize="15sp" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <Switch
                            android:id="@+id/switch_is_open"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:thumbTint="@color/blue_light"
                            android:trackTint="@color/blue_light"/>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginEnd="16dp"
                    android:background="@drawable/bg_round_stripe"
                    android:clipToOutline="true"
                    android:elevation="2dp"
                    android:padding="1dp">

                    <Button
                        android:id="@+id/btn_register_store_owner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_round_stripe_orange"
                        android:text="注册成为店主"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        app:backgroundTint="@color/blue_light"/>
                </LinearLayout>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
</layout>