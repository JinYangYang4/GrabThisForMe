<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <import type="android.view.View" />

        <variable
            name="viewModel"
            type="com.example.grabthisforme.activity.mainactivity.viewmodel.MainViewModel" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/gray_mid_light"
        android:orientation="vertical">

        <androidx.drawerlayout.widget.DrawerLayout
            android:id="@+id/drawer_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <androidx.fragment.app.FragmentContainerView
                        android:id="@+id/nav_host_fragment"
                        android:name="androidx.navigation.fragment.NavHostFragment"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:visibility="@{viewModel.openNewFragment ? View.GONE : View.VISIBLE}"
                        app:defaultNavHost="true" />

                    <androidx.fragment.app.FragmentContainerView
                        android:id="@+id/nav_new_fragment"
                        android:name="androidx.navigation.fragment.NavHostFragment"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:visibility="@{viewModel.openNewFragment ? View.VISIBLE : View.GONE}"
                        app:defaultNavHost="true" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"
                        android:background="@color/gray_translucent_dark" />

                    <LinearLayout
                        android:id="@+id/bottom_bar"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:visibility="@{viewModel.openNewFragment ? View.GONE : View.VISIBLE}">

                        <LinearLayout
                            android:id="@+id/llHome"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:alpha="@{viewModel.selectedTab == 0 ? 1f : 0.5f}"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <ImageView
                                android:layout_width="25dp"
                                android:layout_height="25dp"
                                android:background="@drawable/bg_circle"
                                android:backgroundTint="@color/white_fff8"
                                android:clipToOutline="true"
                                android:padding="2dp"
                                android:scaleType="centerCrop"
                                android:src="@drawable/ic_home" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="首页"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/llCommunity"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:alpha="@{viewModel.selectedTab == 1 ? 1f : 0.5f}"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <ImageView
                                android:layout_width="25dp"
                                android:layout_height="25dp"
                                android:background="@drawable/bg_circle"
                                android:backgroundTint="@color/white_fff8"
                                android:clipToOutline="true"
                                android:padding="2dp"
                                android:scaleType="centerCrop"
                                android:src="@drawable/ic_community" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="社区"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/llInformation"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:alpha="@{viewModel.selectedTab == 2 ? 1f : 0.5f}"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <ImageView
                                android:layout_width="25dp"
                                android:layout_height="25dp"
                                android:background="@drawable/bg_circle"
                                android:backgroundTint="@color/white_fff8"
                                android:clipToOutline="true"
                                android:padding="2dp"
                                android:scaleType="centerCrop"
                                android:src="@drawable/ic_information" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="消息"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/llMy"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:alpha="@{viewModel.selectedTab == 3 ? 1f : 0.5f}"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <ImageView
                                android:layout_width="25dp"
                                android:layout_height="25dp"
                                android:background="@drawable/bg_circle"
                                android:backgroundTint="@color/white_fff8"
                                android:clipToOutline="true"
                                android:padding="2dp"
                                android:scaleType="centerCrop"
                                android:src="@drawable/ic_my" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="我的"
                                android:textSize="10sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <LinearLayout
                android:id="@+id/custom_drawer_menu"
                android:layout_width="316dp"
                android:layout_height="match_parent"
                android:layout_gravity="start"
                android:background="@drawable/bg_drawer_surface"
                android:clipToPadding="false"
                android:orientation="vertical">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/back_img_part"
                    android:layout_width="match_parent"
                    android:layout_height="238dp"
                    tools:ignore="MissingConstraints">

                    <ImageView
                        android:id="@+id/iv_back_charactor"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/home_campus_service_banner"
                        app:layout_collapseMode="parallax"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:background="@drawable/bg_drawer_image_scrim"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="18dp"
                        android:layout_marginTop="26dp"
                        android:layout_marginEnd="18dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <LinearLayout
                            android:id="@+id/ll_set_btn"
                            android:layout_width="wrap_content"
                            android:layout_height="38dp"
                            android:background="@drawable/bg_drawer_top_pill"
                            android:foreground="?attr/selectableItemBackground"
                            android:gravity="center_vertical"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:src="@drawable/ic_set" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="7dp"
                                android:text="设置"
                                android:textColor="#162E27"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <Space
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="38dp"
                            android:alpha="0.88"
                            android:background="@drawable/bg_drawer_top_pill"
                            android:gravity="center_vertical"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:src="@drawable/scan" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="7dp"
                                android:text="扫码"
                                android:textColor="#162E27"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/drawer_profile_card"
                        android:layout_width="0dp"
                        android:layout_height="94dp"
                        android:layout_marginStart="14dp"
                        android:layout_marginEnd="14dp"
                        android:layout_marginBottom="14dp"
                        android:background="@drawable/bg_drawer_glass_card"
                        android:elevation="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent">

                        <ImageView
                            android:id="@+id/iv_head_pic"
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:background="@drawable/bg_circle"
                            android:backgroundTint="#FFFFFF"
                            android:clipToOutline="true"
                            android:elevation="4dp"
                            android:padding="3dp"
                            android:scaleType="centerCrop"
                            android:src="@drawable/cat" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="13dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="@{viewModel.currentUser.name}"
                                android:textColor="#12241F"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text='@{"ID " + String.valueOf(viewModel.currentUser.id)}'
                                android:textColor="#64756F"
                                android:textSize="12sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="25dp"
                                android:layout_marginTop="8dp"
                                android:background="@drawable/bg_drawer_status_chip"
                                android:gravity="center"
                                android:paddingStart="10dp"
                                android:paddingEnd="10dp"
                                android:text="校园生活服务"
                                android:textColor="#FFFFFF"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.core.widget.NestedScrollView
                    android:id="@+id/nestedScrollView_menu"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:clipToPadding="false"
                    android:overScrollMode="never"
                    app:layout_constraintTop_toBottomOf="@+id/back_img_part">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:id="@+id/drawer_quick_tools_card"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_marginTop="14dp"
                            android:layout_marginEnd="12dp"
                            android:background="@drawable/bg_drawer_card"
                            android:elevation="6dp"
                            android:orientation="vertical"
                            android:padding="14dp">

                            <LinearLayout
                                android:id="@+id/ll_menu_tool_back"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="常用工具"
                                    android:textColor="#142D26"
                                    android:textSize="17sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:background="@drawable/bg_home_chip_light"
                                    android:paddingStart="10dp"
                                    android:paddingTop="5dp"
                                    android:paddingEnd="10dp"
                                    android:paddingBottom="5dp"
                                    android:text="快捷入口"
                                    android:textColor="#1D6F5E"
                                    android:textSize="11sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <GridLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:alignmentMode="alignMargins"
                                android:columnCount="3"
                                android:rowCount="2"
                                android:useDefaultMargins="false">

                                <LinearLayout
                                    android:id="@+id/ll_history_order_btn"
                                    android:layout_width="0dp"
                                    android:layout_height="88dp"
                                    android:layout_columnWeight="1"
                                    android:layout_margin="4dp"
                                    android:background="@drawable/bg_drawer_tool_tile"
                                    android:foreground="?attr/selectableItemBackground"
                                    android:gravity="center"
                                    android:orientation="vertical">

                                    <ImageView
                                        android:layout_width="38dp"
                                        android:layout_height="38dp"
                                        android:background="@drawable/bg_drawer_icon_blue"
                                        android:padding="8dp"
                                        android:src="@drawable/ic_history" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="7dp"
                                        android:text="历史订单"
                                        android:textColor="#243A35"
                                        android:textSize="12sp"
                                        android:textStyle="bold" />
                                </LinearLayout>

                                <LinearLayout
                                    android:id="@+id/ll_coupon_btn"
                                    android:layout_width="0dp"
                                    android:layout_height="88dp"
                                    android:layout_columnWeight="1"
                                    android:layout_margin="4dp"
                                    android:background="@drawable/bg_drawer_tool_tile"
                                    android:foreground="?attr/selectableItemBackground"
                                    android:gravity="center"
                                    android:orientation="vertical">

                                    <ImageView
                                        android:layout_width="38dp"
                                        android:layout_height="38dp"
                                        android:background="@drawable/bg_drawer_icon_orange"
                                        android:padding="8dp"
                                        android:src="@drawable/ic_voucher" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="7dp"
                                        android:text="优惠券"
                                        android:textColor="#243A35"
                                        android:textSize="12sp"
                                        android:textStyle="bold" />
                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="88dp"
                                    android:layout_columnWeight="1"
                                    android:layout_margin="4dp"
                                    android:background="@drawable/bg_drawer_tool_tile"
                                    android:foreground="?attr/selectableItemBackground"
                                    android:gravity="center"
                                    android:orientation="vertical">

                                    <ImageView
                                        android:layout_width="38dp"
                                        android:layout_height="38dp"
                                        android:background="@drawable/bg_drawer_icon_coral"
                                        android:padding="8dp"
                                        android:src="@drawable/ic_group_buying" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="7dp"
                                        android:text="拼单团购"
                                        android:textColor="#243A35"
                                        android:textSize="12sp"
                                        android:textStyle="bold" />
                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="88dp"
                                    android:layout_columnWeight="1"
                                    android:layout_margin="4dp"
                                    android:background="@drawable/bg_drawer_tool_tile"
                                    android:foreground="?attr/selectableItemBackground"
                                    android:gravity="center"
                                    android:orientation="vertical">

                                    <ImageView
                                        android:layout_width="38dp"
                                        android:layout_height="38dp"
                                        android:background="@drawable/bg_drawer_icon_cyan"
                                        android:padding="8dp"
                                        android:src="@drawable/ic_run" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="7dp"
                                        android:text="帮我跑"
                                        android:textColor="#243A35"
                                        android:textSize="12sp"
                                        android:textStyle="bold" />
                                </LinearLayout>

                                <LinearLayout
                                    android:id="@+id/ll_register_store_owner"
                                    android:layout_width="0dp"
                                    android:layout_height="88dp"
                                    android:layout_columnWeight="1"
                                    android:layout_margin="4dp"
                                    android:background="@drawable/bg_drawer_tool_tile"
                                    android:foreground="?attr/selectableItemBackground"
                                    android:gravity="center"
                                    android:orientation="vertical">

                                    <ImageView
                                        android:layout_width="38dp"
                                        android:layout_height="38dp"
                                        android:background="@drawable/bg_drawer_icon_mint"
                                        android:padding="8dp"
                                        android:src="@drawable/ic_register" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="7dp"
                                        android:text="注册商家"
                                        android:textColor="#243A35"
                                        android:textSize="12sp"
                                        android:textStyle="bold" />
                                </LinearLayout>

                                <LinearLayout
                                    android:id="@+id/ll_register_runer"
                                    android:layout_width="0dp"
                                    android:layout_height="88dp"
                                    android:layout_columnWeight="1"
                                    android:layout_margin="4dp"
                                    android:background="@drawable/bg_drawer_tool_tile"
                                    android:foreground="?attr/selectableItemBackground"
                                    android:gravity="center"
                                    android:orientation="vertical">

                                    <ImageView
                                        android:layout_width="38dp"
                                        android:layout_height="38dp"
                                        android:background="@drawable/bg_drawer_icon_lavender"
                                        android:padding="8dp"
                                        android:src="@drawable/ic_register" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="7dp"
                                        android:text="注册跑者"
                                        android:textColor="#243A35"
                                        android:textSize="12sp"
                                        android:textStyle="bold" />
                                </LinearLayout>
                            </GridLayout>
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/drawer_people_card"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_marginTop="12dp"
                            android:layout_marginEnd="12dp"
                            android:background="@drawable/bg_drawer_card"
                            android:elevation="5dp"
                            android:orientation="vertical"
                            android:padding="14dp">

                            <LinearLayout
                                android:id="@+id/ll_menu_people_back"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="常联系的人"
                                    android:textColor="#142D26"
                                    android:textSize="16sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="查看全部"
                                    android:textColor="#71908A"
                                    android:textSize="12sp" />
                            </LinearLayout>

                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/rv_user"
                                android:layout_width="match_parent"
                                android:layout_height="118dp"
                                android:layout_marginTop="10dp"
                                android:clipToPadding="false"
                                android:overScrollMode="never" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/drawer_store_card"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_marginTop="12dp"
                            android:layout_marginEnd="12dp"
                            android:background="@drawable/bg_drawer_card"
                            android:elevation="5dp"
                            android:orientation="vertical"
                            android:padding="14dp">

                            <LinearLayout
                                android:id="@+id/ll_menu_shop_back"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="常逛的店铺"
                                    android:textColor="#142D26"
                                    android:textSize="16sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="发现更多"
                                    android:textColor="#71908A"
                                    android:textSize="12sp" />
                            </LinearLayout>

                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/rv_store"
                                android:layout_width="match_parent"
                                android:layout_height="118dp"
                                android:layout_marginTop="10dp"
                                android:clipToPadding="false"
                                android:overScrollMode="never" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/drawer_logout_card"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:layout_marginStart="12dp"
                            android:layout_marginTop="12dp"
                            android:layout_marginEnd="12dp"
                            android:layout_marginBottom="18dp"
                            android:background="@drawable/bg_drawer_logout_card"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="16dp"
                            android:paddingEnd="18dp">

                            <ImageView
                                android:id="@+id/logout"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_logout" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:text="退出登录"
                                android:textColor="#8C3529"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="切换账号或离开"
                                android:textColor="#B16A5B"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>
                </androidx.core.widget.NestedScrollView>
            </LinearLayout>
        </androidx.drawerlayout.widget.DrawerLayout>
    </LinearLayout>
</layout>
