<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">
    <data>
        <import type="android.view.View" />
        <variable
            name="viewModel"
            type="com.example.grabthisforme.activity.mainactivity.viewmodel.MainViewModel" />
    </data>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/gray_mid_light"
        android:orientation="vertical">
        <androidx.drawerlayout.widget.DrawerLayout
            android:id="@+id/drawer_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <androidx.fragment.app.FragmentContainerView
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:visibility="@{viewModel.openNewFragment ? View.GONE : View.VISIBLE}"
                        android:id="@+id/nav_host_fragment"
                        android:name="androidx.navigation.fragment.NavHostFragment"
                        app:defaultNavHost = "true">
                    </androidx.fragment.app.FragmentContainerView>
                    <androidx.fragment.app.FragmentContainerView
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:visibility="@{viewModel.openNewFragment ? View.VISIBLE : View.GONE}"
                        android:layout_weight="1"
                        android:id="@+id/nav_new_fragment"
                        android:name="androidx.navigation.fragment.NavHostFragment"
                        app:defaultNavHost = "true">
                    </androidx.fragment.app.FragmentContainerView>
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"
                        android:background="@color/gray_translucent_dark"/>
                    <LinearLayout
                        android:id="@+id/bottom_bar"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:visibility="@{viewModel.openNewFragment ? View.GONE : View.VISIBLE}"
                        android:gravity="center"
                        android:orientation="horizontal">
                        <LinearLayout
                            android:id="@+id/llHome"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:alpha="@{viewModel.selectedTab == 0 ? 1f : 0.5f}"
                            android:orientation="vertical"
                            android:layout_weight="1"
                            android:gravity="center_horizontal">
                            <ImageView
                                android:layout_width="25dp"
                                android:layout_height="25dp"
                                android:padding="2dp"
                                android:backgroundTint="@color/white_fff8"
                                android:background="@drawable/bg_circle"
                                android:scaleType="centerCrop"
                                android:clipToOutline="true"
                                android:src="@drawable/ic_home"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="10sp"
                                android:layout_marginTop="4dp"
                                android:text="首页"/>
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:id="@+id/llCommunity"
                            android:alpha="@{viewModel.selectedTab == 1 ? 1f : 0.5f}"
                            android:orientation="vertical"
                            android:layout_weight="1"
                            android:gravity="center_horizontal">
                            <ImageView
                                android:layout_width="25dp"
                                android:layout_height="25dp"
                                android:padding="2dp"
                                android:backgroundTint="@color/white_fff8"
                                android:background="@drawable/bg_circle"
                                android:scaleType="centerCrop"
                                android:clipToOutline="true"
                                android:src="@drawable/ic_community"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="10sp"
                                android:layout_marginTop="4dp"
                                android:text="社区"/>
                        </LinearLayout>
                        <LinearLayout
                            android:id="@+id/llInformation"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:alpha="@{viewModel.selectedTab == 2 ? 1f : 0.5f}"
                            android:orientation="vertical"
                            android:layout_weight="1"
                            android:gravity="center_horizontal">
                            <ImageView
                                android:layout_width="25dp"
                                android:layout_height="25dp"
                                android:padding="2dp"
                                android:backgroundTint="@color/white_fff8"
                                android:background="@drawable/bg_circle"
                                android:scaleType="centerCrop"
                                android:clipToOutline="true"
                                android:src="@drawable/ic_information"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="10sp"
                                android:layout_marginTop="4dp"
                                android:text="消息"/>
                        </LinearLayout>
                        <LinearLayout
                            android:id="@+id/llMy"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:alpha="@{viewModel.selectedTab == 3 ? 1f : 0.5f}"
                            android:orientation="vertical"
                            android:layout_weight="1"
                            android:gravity="center_horizontal">
                            <ImageView
                                android:layout_width="25dp"
                                android:layout_height="25dp"
                                android:padding="2dp"
                                android:backgroundTint="@color/white_fff8"
                                android:background="@drawable/bg_circle"
                                android:scaleType="centerCrop"
                                android:clipToOutline="true"
                                android:src="@drawable/ic_my"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="10sp"
                                android:layout_marginTop="4dp"
                                android:text="我的"/>
                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <LinearLayout
                android:id="@+id/custom_drawer_menu"
                android:layout_width="280dp"
                android:layout_height="match_parent"
                android:layout_gravity="start"
                android:background="@drawable/bg_round_stripe_end"
                android:backgroundTint="@color/white_fff8"
                android:orientation="vertical">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:id="@+id/back_img_part"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="3dp"
                    android:layout_marginTop="3dp"
                    tools:ignore="MissingConstraints">
                    <ImageView
                        android:id="@+id/iv_back_charactor"
                        android:layout_width="match_parent"
                        android:layout_height="180dp"
                        android:scaleType="centerCrop"
                        android:clipToOutline="true"
                        android:background="@drawable/bg_round_stripe_right_top"
                        android:src="@drawable/ic_back_charactor2"
                        app:layout_collapseMode="parallax" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        android:layout_marginStart="20dp"
                        android:layout_marginTop="25dp">
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_round_stripe"
                            android:gravity="center_vertical"
                            android:padding="4dp"
                            android:backgroundTint="@color/gray_translucent_dark">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="设置"
                                android:layout_marginStart="3dp"
                                android:textSize="13sp"/>
                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_marginStart="7dp"
                                android:src="@drawable/ic_set"/>
                        </LinearLayout>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            tools:ignore="InefficientWeight">
                        </TextView>
                        <LinearLayout
                            android:padding="4dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="20dp"
                            android:background="@drawable/bg_round_stripe"
                            android:gravity="center_vertical"
                            android:alpha="0.7"
                            android:backgroundTint="@color/gray_translucent_dark">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="扫描"
                                android:layout_marginStart="3dp"
                                android:textSize="13sp"/>
                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_marginStart="7dp"
                                android:src="@drawable/scan"/>
                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        android:layout_margin="20dp"
                        android:gravity="center_vertical">
                        <ImageView
                            android:id="@+id/iv_head_pic"
                            android:layout_width="60dp"
                            android:layout_height="60dp"
                            android:padding="2dp"
                            android:backgroundTint="@color/white_fff8"
                            android:background="@drawable/bg_circle"
                            android:scaleType="centerCrop"
                            android:clipToOutline="true"
                            android:src="@drawable/cat"/>
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="20dp"
                                android:text="@{viewModel.currentUser.name}"
                                android:textSize="18sp">
                            </TextView>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="20dp"
                                android:text="@{String.valueOf(viewModel.currentUser.id)}"
                                android:textSize="14sp"/>

                        </LinearLayout>

                    </LinearLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.core.widget.NestedScrollView
                    android:id="@+id/nestedScrollView_menu"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:layout_constraintTop_toBottomOf="@+id/back_img_part"
                    android:layout_marginBottom="20dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="4dp"
                        android:orientation="vertical">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_round_stripe_white"
                            android:elevation="1dp"
                            android:backgroundTint="@color/white"
                            android:orientation="vertical">
                            <LinearLayout
                                android:id="@+id/ll_menu_people_back"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:padding="3dp"
                                android:gravity="center_vertical"
                                android:background='@{viewModel.page == 0 ? @drawable/bg_arc_gradient : @drawable/bg_arc_gradient_green}'>
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="10dp"
                                    android:textSize="16sp"
                                    android:text="常帮我带的人"/>
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"/>
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="查看全部"
                                    android:textSize="14sp"
                                    android:alpha="0.8"
                                    android:layout_marginEnd="10dp"/>
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="150dp"
                                android:background="@drawable/bg_round_rect_top_small_bottom_large"
                                >
                                <androidx.recyclerview.widget.RecyclerView
                                    android:layout_marginTop="5dp"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:id="@+id/rv_user">
                                </androidx.recyclerview.widget.RecyclerView>
                            </LinearLayout>
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/bg_round_stripe_white"
                            android:elevation="1dp"
                            android:backgroundTint="@color/white"
                            android:orientation="vertical">
                            <LinearLayout
                                android:id="@+id/ll_menu_shop_back"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:padding="3dp"
                                android:gravity="center_vertical"
                                android:background='@{viewModel.page == 0 ? @drawable/bg_arc_gradient : @drawable/bg_arc_gradient_green}'>
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="10dp"
                                    android:textSize="16sp"
                                    android:text="常看的店铺"/>
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"/>
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="查看全部"
                                    android:textSize="14sp"
                                    android:alpha="0.8"
                                    android:layout_marginEnd="10dp"/>
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="150dp"
                                android:background="@drawable/bg_round_rect_top_small_bottom_large"
                                >
                                <androidx.recyclerview.widget.RecyclerView
                                    android:layout_marginTop="5dp"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:id="@+id/rv_store">
                                </androidx.recyclerview.widget.RecyclerView>
                            </LinearLayout>
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/bg_round_stripe_white"
                            android:elevation="1dp"
                            android:backgroundTint="@color/white"
                            android:orientation="vertical">
                            <LinearLayout
                                android:id="@+id/ll_menu_tool_back"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:padding="3dp"
                                android:gravity="center_vertical"
                                android:background='@{viewModel.page == 0 ? @drawable/bg_arc_gradient : @drawable/bg_arc_gradient_green}'>
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="10dp"
                                    android:textSize="16sp"
                                    android:text="常用工具"/>
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"/>
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textSize="14sp"
                                    android:alpha="0.8"
                                    android:layout_marginEnd="10dp"/>
                            </LinearLayout>
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_margin="5dp"
                                android:orientation="horizontal">
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:gravity="center_horizontal"
                                    android:orientation="vertical">
                                    <ImageView
                                        android:layout_width="45dp"
                                        android:layout_height="45dp"
                                        android:padding="2dp"
                                        android:background="@drawable/bg_circle"
                                        android:scaleType="centerCrop"
                                        android:clipToOutline="true"
                                        android:src="@drawable/ic_history"/>
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:textSize="10sp"
                                        android:layout_marginTop="4dp"
                                        android:text="历史订单"/>
                                </LinearLayout>
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:gravity="center_horizontal"
                                    android:orientation="vertical">
                                    <ImageView
                                        android:layout_width="45dp"
                                        android:layout_height="45dp"
                                        android:padding="2dp"
                                        android:background="@drawable/bg_circle"
                                        android:scaleType="centerCrop"
                                        android:clipToOutline="true"
                                        android:src="@drawable/ic_voucher"/>
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:textSize="10sp"
                                        android:layout_marginTop="4dp"
                                        android:text="优惠券"/>
                                </LinearLayout>
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:gravity="center_horizontal"
                                    android:orientation="vertical">
                                    <ImageView
                                        android:layout_width="45dp"
                                        android:layout_height="45dp"
                                        android:padding="2dp"
                                        android:backgroundTint="@color/white_fff8"
                                        android:background="@drawable/bg_circle"
                                        android:scaleType="centerCrop"
                                        android:clipToOutline="true"
                                        android:src="@drawable/ic_group_buying"/>
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:textSize="10sp"
                                        android:layout_marginTop="4dp"
                                        android:text="团购"/>
                                </LinearLayout>
                            </LinearLayout>
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_margin="5dp"
                                android:orientation="horizontal">
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:gravity="center_horizontal"
                                    android:orientation="vertical">
                                    <ImageView
                                        android:layout_width="45dp"
                                        android:layout_height="45dp"
                                        android:padding="2dp"
                                        android:background="@drawable/bg_circle"
                                        android:scaleType="centerCrop"
                                        android:clipToOutline="true"
                                        android:src="@drawable/ic_run"/>
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:textSize="10sp"
                                        android:layout_marginTop="4dp"
                                        android:text="帮我跑"/>
                                </LinearLayout>
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:gravity="center_horizontal"
                                    android:id="@+id/ll_register_store_owner"
                                    android:orientation="vertical">
                                    <ImageView
                                        android:layout_width="45dp"
                                        android:layout_height="45dp"
                                        android:padding="2dp"
                                        android:backgroundTint="@color/white_fff8"
                                        android:background="@drawable/bg_circle"
                                        android:scaleType="centerCrop"
                                        android:clipToOutline="true"
                                        android:src="@drawable/ic_register"/>
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:textSize="10sp"
                                        android:layout_marginTop="4dp"
                                        android:text="注册商家"/>
                                </LinearLayout>
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:id="@+id/ll_register_runer"
                                    android:gravity="center_horizontal"
                                    android:orientation="vertical">
                                    <ImageView
                                        android:layout_width="45dp"
                                        android:layout_height="45dp"
                                        android:padding="2dp"
                                        android:backgroundTint="@color/white_fff8"
                                        android:background="@drawable/bg_circle"
                                        android:scaleType="centerCrop"
                                        android:clipToOutline="true"
                                        android:src="@drawable/ic_register"/>
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:textSize="10sp"
                                        android:layout_marginTop="4dp"
                                        android:text="注册跑者"/>
                                </LinearLayout>

                            </LinearLayout>
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="2dp"
                            android:id="@+id/ll_menu_back_1"
                            android:layout_marginTop="10dp"
                            android:background='@{viewModel.page == 0 ? @drawable/bg_arc_gradient : @drawable/bg_arc_gradient_green}'
                            tools:ignore="Orientation" />




                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7dp"
                            android:padding="5dp"
                            android:background="@drawable/bg_round_stripe_white"
                            android:elevation="1dp"
                            android:backgroundTint="@color/white"
                            android:orientation="vertical">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">
                                <ImageView
                                    android:id="@+id/logout"
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:scaleType="centerCrop"
                                    android:layout_marginStart="25dp"
                                    android:src="@drawable/ic_logout"/>
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"/>
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="20dp"
                                    android:layout_marginEnd="20dp"
                                    android:text="退出登录"/>
                            </LinearLayout>

                        </LinearLayout>

                    </LinearLayout>

                </androidx.core.widget.NestedScrollView>
            </LinearLayout>

        </androidx.drawerlayout.widget.DrawerLayout>
    </LinearLayout>
</layout>
