<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:ignore="MissingConstraints">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_arc_radient_fragment_home1"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/toolbar_back"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:layout_marginBottom="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/YGet"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="25dp"
                    android:gravity="center"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/GetByOther"
                        android:textSize="20sp" />

                    <LinearLayout
                        android:layout_width="25dp"
                        android:layout_height="4dp"
                        android:layout_marginTop="5dp"
                        android:background="@drawable/bg_round_stripe"
                        android:backgroundTint="@color/orange_primary"
                        android:alpha="0" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="25dp"
                    android:gravity="center"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/GiveOther"
                        android:textSize="20sp" />

                    <LinearLayout
                        android:layout_width="25dp"
                        android:layout_height="4dp"
                        android:layout_marginTop="5dp"
                        android:background="@drawable/bg_round_stripe"
                        android:backgroundTint="@color/green_primary" />
                </LinearLayout>
            </LinearLayout>
            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />
            <ImageView
                android:id="@+id/iv_head_pic"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="20dp"
                android:background="@drawable/bg_circle"
                android:clipToOutline="true"
                android:scaleType="centerCrop"
                android:src="@drawable/cat" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="4dp"
            android:layout_margin="10dp"
            android:background="@drawable/bg_round_stripe"
            android:backgroundTint="@color/white_fff8"
            android:orientation="horizontal"
            android:gravity="center">
            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_search"
                android:scaleType="centerCrop"
                android:alpha="0.5"/>
            <TextView
                android:layout_marginStart="7dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="搜索"
                android:textSize="16sp"/>

        </LinearLayout>

        <androidx.core.widget.NestedScrollView
            android:id="@+id/nestedScrollView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:elevation="8dp"
                    android:backgroundTint="@color/white"
                    android:background="@drawable/bg_round_stripe"
                    android:id="@+id/select"
                    app:layout_constraintTop_toBottomOf="@+id/toolbar_back"
                    android:layout_margin="9dp"
                    android:gravity="center">
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_weight="1"
                        android:gravity="center">
                        <ImageView
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:scaleType="centerCrop"
                            android:src="@drawable/order">
                        </ImageView>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="订单"
                            android:textSize="10sp">
                        </TextView>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_weight="1"
                        android:gravity="center">
                        <ImageView
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:scaleType="centerCrop"
                            android:src="@drawable/ic_task">
                        </ImageView>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="任务"
                            android:textSize="10sp">
                        </TextView>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">
                        <ImageView
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:scaleType="centerCrop"
                            android:src="@drawable/ic_goods">
                        </ImageView>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="商品"
                            android:textSize="10sp">
                        </TextView>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">
                        <ImageView
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:scaleType="centerCrop"
                            android:src="@drawable/ic_payment_qr_code">
                        </ImageView>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="收款码"
                            android:textSize="10sp">
                        </TextView>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/dropContainer"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_round_stripe"
                    android:backgroundTint="@color/white"
                    android:layout_marginLeft="9dp"
                    android:layout_marginRight="9dp"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="15dp"
                        android:layout_marginTop="3dp"
                        android:textSize="17sp"
                        android:text="执行订单"/>
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_task"
                        android:layout_width="match_parent"
                        android:layout_margin="5dp"
                        android:elevation="20dp"
                        android:background="@drawable/bg_round_stripe"
                        android:clipChildren="true"
                        android:clipToPadding="true"
                        android:padding="8dp"
                        android:layout_height="230dp">
                    </androidx.recyclerview.widget.RecyclerView>
                    <LinearLayout
                        android:id="@+id/ll_dropdown"
                        android:layout_width="match_parent"
                        android:gravity="center"
                        android:layout_height="wrap_content">
                        <ImageView
                            android:visibility="gone"
                            android:id="@+id/iv_dropdown"
                            android:layout_width="25dp"
                            android:layout_height="25dp"
                            android:scaleType="centerCrop"
                            android:layout_margin="5dp"
                            android:src="@drawable/ic_dropdown"
                            android:layout_marginVertical="5dp"
                            android:layout_gravity="center">
                        </ImageView>
                    </LinearLayout>


                </LinearLayout>
                <LinearLayout
                    android:id="@+id/ll_send_order"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_round_stripe"
                    android:backgroundTint="@color/white"
                    android:layout_marginLeft="9dp"
                    android:layout_marginRight="9dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="15dp"
                        android:layout_marginTop="3dp"
                        android:textSize="17sp"
                        android:text="去接单"/>
                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="10dp"
                        android:background="@drawable/bg_round_stripe"
                        android:backgroundTint="@color/white"
                        android:padding="8dp"
                        android:scrollbars="none">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <!-- 筛选标签：全部任务 -->
                            <TextView
                                android:id="@+id/tv_filter_all"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginHorizontal="8dp"
                                android:background="@drawable/bg_round_stripe"
                                android:backgroundTint="@color/green_primary"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="4dp"
                                android:text="全部任务"
                                android:textColor="@color/white"
                                android:textSize="14sp" />

                            <!-- 筛选标签：附近任务 -->
                            <TextView
                                android:id="@+id/tv_filter_near"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginHorizontal="8dp"
                                android:background="@drawable/bg_round_stripe"
                                android:backgroundTint="@color/white"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="4dp"
                                android:text="附近任务"
                                android:textColor="@color/black"
                                android:textSize="14sp" />

                            <!-- 筛选标签：紧急任务 -->
                            <TextView
                                android:id="@+id/tv_filter_urgent"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginHorizontal="8dp"
                                android:background="@drawable/bg_round_stripe"
                                android:backgroundTint="@color/white"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="4dp"
                                android:text="紧急任务"
                                android:textColor="@color/black"
                                android:textSize="14sp" />

                            <!-- 新增更多筛选标签（示例） -->
                            <TextView
                                android:id="@+id/tv_filter_food"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginHorizontal="8dp"
                                android:background="@drawable/bg_round_stripe"
                                android:backgroundTint="@color/white"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="4dp"
                                android:text="食品类"
                                android:textColor="@color/black"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/tv_filter_file"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginHorizontal="8dp"
                                android:background="@drawable/bg_round_stripe"
                                android:backgroundTint="@color/white"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="4dp"
                                android:text="文件类"
                                android:textColor="@color/black"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/tv_filter_package"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginHorizontal="8dp"
                                android:background="@drawable/bg_round_stripe"
                                android:backgroundTint="@color/white"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="4dp"
                                android:text="包裹类"
                                android:textColor="@color/black"
                                android:textSize="14sp" />
                        </LinearLayout>
                    </HorizontalScrollView>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/black">

                    </LinearLayout>
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_order"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="5dp"
                        android:elevation="20dp"
                        android:background="@drawable/bg_round_stripe"
                        android:clipChildren="true"
                        android:clipToPadding="true"
                        android:padding="8dp">
                    </androidx.recyclerview.widget.RecyclerView>

                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>



    </LinearLayout>
</layout>