<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_round_rect_top_small_bottom_large"
        android:layout_marginVertical="5dp"
        android:layout_marginHorizontal="3dp"
        android:elevation="8dp"
        android:padding="0dp"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            android:orientation="vertical"
            android:clipChildren="true"
            android:elevation="1dp"
            android:background="@drawable/bg_rounded_white"
            android:outlineProvider="background">
            <ImageView
                android:id="@+id/goods_pic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:src="@drawable/food_pic"
                android:background="@drawable/bg_round_rect_top_small_bottom_no"
                android:scaleType="centerCrop"
                android:clipToOutline="true"
                android:adjustViewBounds="true"
                android:maxHeight="270dp"/>
            <TextView
                android:id="@+id/goods_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                android:textSize="14sp"
                android:text="一口酥脆，满心甜蜜！麦丽素治愈时刻上线"
                android:maxLines="1"/>
             <LinearLayout
                 android:layout_width="match_parent"
                 android:layout_height="wrap_content"
                 android:gravity="center_vertical">
                 <TextView
                     android:layout_width="wrap_content"
                     android:layout_height="wrap_content"
                     android:layout_margin="3dp"
                     android:text="￥"
                     android:textSize="13sp"
                     android:textColor="@color/red_cherry"/>

                 <TextView
                     android:id="@+id/goods_price"
                     android:layout_width="wrap_content"
                     android:layout_height="wrap_content"
                     android:textColor="@color/red_cherry"
                     android:text="60.00"
                     android:textSize="20sp"/>
                 <TextView
                     android:layout_width="wrap_content"
                     android:layout_height="wrap_content"
                     android:text="到手价"
                     android:textColor="@color/red_cherry"
                     android:textSize="13sp"/>
             </LinearLayout>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_rounded_rect_red_stroke"
                android:orientation="horizontal">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_rounded_rect_red_stroke">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="10sp"
                        android:text="买一送一"
                        android:textColor="@color/red_cherry"
                        android:padding="5dp"/>
                </LinearLayout>

            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginEnd="10dp"
                android:gravity="bottom|end">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="15dp"
                    android:text="销量:"
                    android:textSize="12sp"
                    android:alpha="0.8"/>
                <TextView
                    android:id="@+id/goods_sales"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:alpha="0.8"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+"
                    android:textSize="12sp"
                    android:alpha="0.8"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</layout>
