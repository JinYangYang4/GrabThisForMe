<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="viewModel"
            type="com.example.grabthisforme.activity.fragment_misc.post_topic.viewmodel.PostTopicViewModel" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/gray_mid_light"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_arc_gradient_orange"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="30dp"
            android:paddingBottom="10dp"
            android:paddingHorizontal="16dp">

            <ImageView
                android:id="@+id/iv_back"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_back" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="18dp"
                android:text="发布帖子"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/white">

            <LinearLayout
                android:id="@+id/ll_nested"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/ll_post_info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_round_stripe"
                    android:backgroundTint="@color/white"
                    android:elevation="2dp"

                    android:orientation="vertical"
                    android:paddingVertical="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="帖子信息"
                        android:textColor="#333333"
                        android:textSize="16sp"
                        android:layout_margin="10dp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="8dp"
                        android:background="#E8E8E8" />

                    <TextView
                        android:id="@+id/tv_post_time_hint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="发布时间：发布时自动生成"
                        android:layout_margin="10dp"
                        android:textColor="#999999"
                        android:textSize="13sp" />

                    <com.example.grabthisforme.activity.fragment_misc.chat_fragment.view.NestedScrollableHost
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:layout_marginHorizontal="2dp"
                            android:background="@drawable/bg_round_stripe"
                            android:clipToOutline="true">

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/til_post_content"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_margin="1dp"
                                android:background="@drawable/bg_round_stripe"
                                android:backgroundTint="@color/white"
                                android:elevation="4dp"
                                android:hint="* 帖子正文"
                                app:boxStrokeColor="#E8E8E8"
                                app:boxStrokeWidth="0dp"
                                app:hintEnabled="true"
                                app:hintTextColor="#999999">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/it_post_content"
                                    android:layout_width="match_parent"
                                    android:layout_height="360dp"
                                    android:background="@null"
                                    android:gravity="top"
                                    android:inputType="textMultiLine"
                                    android:maxLines="17"
                                    android:layout_marginBottom="6dp"
                                    android:paddingVertical="8dp"
                                    android:textSize="15sp" />
                            </com.google.android.material.textfield.TextInputLayout>
                        </LinearLayout>
                    </com.example.grabthisforme.activity.fragment_misc.chat_fragment.view.NestedScrollableHost>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="配图（可不填）"
                        android:layout_marginStart="10dp"
                        android:textColor="#999999"
                        android:layout_marginVertical="10dp"
                        android:textSize="15sp" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:layout_marginStart="10dp"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/iv_post_pic"
                                android:layout_width="30dp"
                                android:layout_marginStart="10dp"
                                android:layout_height="30dp"
                                android:scaleType="centerCrop"
                                android:src="@drawable/ic_add" />

                            <TextView
                                android:id="@+id/tv_post_pic_count"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="10dp"
                                android:text='@{"已选 " + String.valueOf(viewModel.selectedImageCount) + " 张"}'
                                android:textColor="#666666"
                                android:textSize="14sp" />
                        </LinearLayout>
                        <androidx.recyclerview.widget.RecyclerView
                            android:visibility="gone"
                            android:id="@+id/rv_images"
                            android:layout_margin="2dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="16dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_round_stripe"
                        android:clipToOutline="true"
                        android:elevation="2dp"
                        android:orientation="horizontal"
                        android:padding="1dp">

                        <Button
                            android:id="@+id/btn_my_saved_post_draft"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_round_stripe"
                            android:text="稿箱"
                            android:textColor="@color/blue_light"
                            app:backgroundTint="@color/white"
                            android:textSize="16sp" />
                    </LinearLayout>

                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="16dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_round_stripe"
                        android:clipToOutline="true"
                        android:elevation="2dp"
                        android:orientation="horizontal"
                        android:padding="1dp">

                        <Button
                            android:id="@+id/btn_save_post_draft"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_round_stripe"
                            android:text="存稿"
                            android:textColor="@color/blue_light"
                            app:backgroundTint="@color/white"
                            android:textSize="16sp" />
                    </LinearLayout>
                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="16dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_round_stripe"
                        android:clipToOutline="true"
                        android:elevation="2dp"
                        android:orientation="horizontal"
                        android:padding="1dp">

                        <Button
                            android:id="@+id/btn_publish_post"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_round_stripe_orange"
                            android:enabled="@{viewModel.canPublish}"
                            android:text="发布"
                            android:textColor="@color/orange_dark"
                            android:textSize="16sp"
                            app:backgroundTint="@color/white" />
                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
</layout>
